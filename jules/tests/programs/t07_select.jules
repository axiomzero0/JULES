// if-conversion -> select + short-circuit logic
fn clamp(x: i64) -> i64 {
    var r: i64 = x;
    if x < 0 { r = 0; } else { r = x; }
    return r;
}

fn main() -> i64 {
    print(clamp(7 as i64));
    print(clamp(-7 as i64));
    let b: bool = true && !false;
    if b { print(1); } else { print(2); }
    return 0 as i64;
}
