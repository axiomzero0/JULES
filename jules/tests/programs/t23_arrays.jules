// arrays: alloc(T, n) + base[index] loads/stores; address arithmetic
// lowers to i64 + Ptr casts; nothing here needs vectorization yet.
fn sum_array(n: i64) -> i64 {
    let a: *mut i64 = alloc(i64, n);
    var i: i64 = 0;
    while i < n {
        a[i] = i * 2 + 1;
        i = i + 1;
    }
    var s: i64 = 0;
    i = 0;
    while i < n {
        s = s + a[i];
        i = i + 1;
    }
    free(a);
    return s;
}

fn fill_f64(n: i64) -> f64 {
    let b: *mut f64 = alloc(f64, n);
    var i: i64 = 0;
    while i < n {
        b[i] = (i as f64) * 0.5 + 1.0;
        i = i + 1;
    }
    var s: f64 = 0.0;
    i = 0;
    while i < n {
        s = s + b[i];
        i = i + 1;
    }
    free(b);
    return s;
}

fn dynamic_count(n: i64) -> i64 {
    // runtime-sized allocation: size = n * 8 computed in IR
    let a: *mut i64 = alloc(i64, n * 2);
    a[0] = 11;
    a[1] = 22;
    a[2 * n - 1] = 77;   // last element of 2n
    let x: i64 = a[0] + a[1] + a[2 * n - 1];
    free(a);
    return x;
}

fn main() -> i64 {
    print(sum_array(10 as i64));       // 1+3+..+19 = 100
    print(sum_array(0 as i64));        // empty
    print(fill_f64(4 as i64));         // 1.5+2+2.5+3 = 9
    print(dynamic_count(5 as i64));    // 11+22+77 = 110
    return 0 as i64;
}
