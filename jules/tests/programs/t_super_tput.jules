// Throughput stress kernel for the superoptimizer: many independent,
// ordinary arithmetic windows (no memory-boundary interruptions), so the
// search core does real work on every window and the rates are dominated
// by the search itself, not window discovery. #[no_inline] keeps the
// shapes in machine code at -O3.

#[no_inline]
fn work(a: i64, b: i64, c: i64, d: i64) -> i64 {
    var s: i64 = 0;
    s = s + a * 5;
    s = s + b + b;
    s = s * 3;
    s = s + c * 9;
    s = s - d - d;
    s = s + (a + b) * 2;
    s = s + (c - d) * 5;
    s = s + a * 17;
    s = s + b * 33;
    s = s + c * 65;
    s = s - d * 7;
    s = s + a + b + c + d;
    s = s + a * 3 + b * 5;
    s = s + c * 6 + d * 10;
    s = s + a * 12 + b * 20;
    s = s + c * 24 + d * 40;
    s = s - a - b - c - d;
    s = s + (a + c) * 3;
    s = s + (b + d) * 9;
    s = s + a * 2 + b * 4 + c * 8 + d * 16;
    return s;
}

fn main() -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 64 {
        t = t + work(i, i * 3 + 1, i * 5 + 2, i * 7 + 3);
        t = t + work(i + 11, i + 13, i + 17, i + 19);
        i = i + 1;
    }
    print(t);
    return 0;
}
