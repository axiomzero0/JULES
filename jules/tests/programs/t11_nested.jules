// nested control + early returns + bitwise ops
fn classify(x: i64) -> i64 {
    if x < 0 { return -1; }
    if x == 0 { return 0; }
    if (x & 1) == 1 { return 1; }
    return 2;
}

fn main() -> i64 {
    print(classify(-5 as i64));
    print(classify(0 as i64));
    print(classify(7 as i64));
    print(classify(8 as i64));
    var i: i64 = 0;
    var acc: i64 = 0;
    while i < 6 {
        if i == 3 { i = i + 1; continue; }
        if i == 5 { break; }
        acc = acc | (1 << i);
        i = i + 1;
    }
    print(acc);
    return 0 as i64;
}
