// LoopFusion: two adjacent loops over the same iteration sequence become
// one loop (one header/guard/IV update instead of two). The reads are
// over disjoint bases; a dependent pair (second loop reads the first
// loop's written array) must NOT fuse.
#[no_inline]
fn two_sums(a: *mut i64, b: *mut i64, n: i64) -> i64 {
    var s1: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s1 = s1 + a[i];
        i = i + 1;
    }
    var s2: i64 = 0;
    i = 0;
    while i < n {
        s2 = s2 + b[i];
        i = i + 1;
    }
    return s1 + s2;
}

// dependent: second loop READS what the first WRITES -> no fusion
#[no_inline]
fn dep_sums(a: *mut i64, n: i64) -> i64 {
    var i: i64 = 0;
    while i < n {
        a[i] = a[i] * 2;
        i = i + 1;
    }
    var s: i64 = 0;
    i = 0;
    while i < n {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    let a: *mut i64 = alloc(i64, 6);
    let b: *mut i64 = alloc(i64, 6);
    var i: i64 = 0;
    while i < 6 {
        a[i] = (i + 1) as i64;
        b[i] = ((i + 1) * 10) as i64;
        i = i + 1;
    }
    print(two_sums(a, b, 6 as i64));  // (1+..+6) + (10+..+60) = 21 + 210 = 231
    print(dep_sums(a, 6 as i64));     // sum of (i+1)*2 = 42
    free(a);
    free(b);
    return 0 as i64;
}
