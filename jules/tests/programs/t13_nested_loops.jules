// nested loops: loop-backedge regions + SCCP executability interplay
// (regression: PhiSimplification left killed backedge regions in successor
// pred lists; SCCP trimmed them as unreachable and loops ran once)
fn mandel(w: i64, h: i64, max_iter: i64) -> i64 {
    var total: i64 = 0;
    var py: i64 = 0;
    while py < h {
        let y0: f64 = ((py as f64) / (h as f64)) * 2.4 - 1.2;
        var px: i64 = 0;
        while px < w {
            let x0: f64 = ((px as f64) / (w as f64)) * 3.0 - 2.1;
            var x: f64 = 0.0;
            var y: f64 = 0.0;
            var iter: i64 = 0;
            while iter < max_iter && x * x + y * y <= 4.0 {
                let xt: f64 = x * x - y * y + x0;
                y = 2.0 * x * y + y0;
                x = xt;
                iter = iter + 1;
            }
            total = total + iter;
            px = px + 1;
        }
        py = py + 1;
    }
    return total;
}

fn nested(n: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var j: i64 = 0;
        while j < n {
            var k: i64 = 0;
            while k < n {
                acc = acc + i * j * k + j;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return acc;
}

fn main() -> i64 {
    print(nested(4 as i64));
    print(mandel(24 as i64, 16 as i64, 50 as i64));
    return 0 as i64;
}
