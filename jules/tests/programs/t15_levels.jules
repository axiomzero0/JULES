// optimization-level matrix: every level must produce identical output.
// Exercises: fused compare-and-branch (short-circuit logic), register
// promotion of loop-carried values, callee-saved values across calls,
// FP constant pooling + loop-invariant hoisting, frame elision, and the
// peephole folds — at -O0 through -Oz.
fn mix(a: i64, b: i64) -> i64 {
    // values live across the recursive call: callee-saved registers
    if a <= 0 { return b; }
    if b <= 0 { return a; }
    let s: i64 = a + b;
    let d: i64 = a - b;
    let r: i64 = mix(a - 1, d);
    return r + s * 2 - d;
}

fn fpsum(n: i64) -> f64 {
    // FP loop-carried values + constants in the loop (const pool/hoisting)
    var x: f64 = 0.5;
    var y: f64 = 1.5;
    var i: i64 = 0;
    while i < n {
        x = x * 0.999 + 0.001;
        y = y - x * 0.25;
        i = i + 1;
    }
    return x * 2.0 + y;
}

fn loops(n: i64) -> i64 {
    // nested counters + fused branch conditions
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var j: i64 = 0;
        while j < n {
            if i * j > 4 { acc = acc + 3; } else { acc = acc + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    return acc;
}

fn main() -> i64 {
    print(mix(9 as i64, 4 as i64));
    print(loops(7 as i64));
    print(fpsum(1000 as i64));
    print((123 as i64) * 456 + 7);
    return 0 as i64;
}
