// PGO (pass 43): instrument -> run -> profile -> use round-trip.
//   * sumto:    dynamic-trip arithmetic loop (param bound, no arrays) —
//               the family pass 42 rejects (bound not const at its slot);
//               profiled avg trip 100 -> factor 4 at -O2
//   * fill_scale: dynamic-trip load/store loop (a[i] = a[i]*3+1) — the
//               epilogue the transform leaves behind is the counted shape
//               the vectorizer can take (the interaction production PGO
//               pipelines get: unrolled main + vectorized remainder)
//   * never:    loop with 0 iterations on both calls (E=2, H=0) — the
//               profile must skip it, not divide by zero
//   * the plain (no --pgo) build must produce the same output: profiles
//               only pick factors, never semantics
fn sumto(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + i * 2 + 1;
        i = i + 1;
    }
    return s;
}

fn fill_scale(a: *mut i64, n: i64) -> i64 {
    var i: i64 = 0;
    while i < n {
        a[i] = a[i] * 3 + 1;
        i = i + 1;
    }
    return a[0] + a[n - 1];
}

fn never(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    print(sumto(100 as i64));        // 10000
    let a: *mut i64 = alloc(i64, 100);
    var i: i64 = 0;
    while i < 100 {
        a[i] = i;
        i = i + 1;
    }
    print(fill_scale(a, 100 as i64)); // 1 + 298 = 299
    free(a);
    print(never(0 as i64));           // 0
    print(never(-5 as i64));          // 0
    return 0 as i64;
}
