// PartialDeoptimization (pass 91): PGO argument sketches drive a guarded
// variant ladder at dynamic-argument call sites.
//   * weigh(mode, a): mode is loop-carried (dynamic at compile time), but
//     199 of 200 loop calls see mode == 1 -> the sketch [first,total,
//     match] = [1, 200+, 199+] marks it hot -> the use build emits
//     guard(mode == 1) { call variant(mode==1) } else { call generic }.
//   * the i == 199 call passes mode == 3: the guard FAILS and execution
//     transfers to the generic rung — the forced-deopt differential: the
//     observable result must be identical to the un-specialized build.
//   * weigh(2, 10) / weigh(5, 7): constant-mode calls are pass 90's
//     domain (static specialization, no guard needed).
// The plain (no --pgo) build and every -O level must produce the same
// output: profiles only pick specializations, never semantics.
#[no_inline]
fn weigh(mode: i64, a: i64) -> i64 {
    if mode == 1 { return a + 100; }
    if mode == 2 { return a * 2 + 7; }
    return a - 1;
}

fn main() -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < 200 {
        var m: i64 = 1;
        if i == 199 { m = 3; }
        acc = acc + weigh(m, i);
        i = i + 1;
    }
    print(acc);            // 39601 + 198 = 39799
    print(weigh(2, 10));   // 27 (static PE)
    print(weigh(5, 7));    // 6
    return 0;
}
