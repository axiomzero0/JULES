// comptime fn recursion at compile time
comptime fn fact(n: i64) -> i64 {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}

const F6: i64 = comptime fact(6);
const TABLE: i64 = comptime {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= 10 {
        s = s + i * i;
        i = i + 1;
    }
    return s;
};

fn main() -> i64 {
    print(F6);
    print(TABLE);
    return 0 as i64;
}
