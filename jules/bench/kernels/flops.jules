// bench: flops — serial f64 multiply-add chains (latency-bound)
fn flops(n: i64) -> f64 {
    var a: f64 = 1.0;
    var b: f64 = 0.5;
    let c: f64 = 0.9999999;
    let d: f64 = 0.000000001;
    let e: f64 = 0.1;
    var i: i64 = 0;
    while i < n {
        a = a * c + d;
        b = b + a * a * e;
        i = i + 1;
    }
    return a + b * 2.0;
}

fn main() -> i64 {
    print(flops(80000000 as i64));
    return 0 as i64;
}
